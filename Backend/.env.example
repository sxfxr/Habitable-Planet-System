# Hosted PostgreSQL: set DATABASE_URL instead of DB_* when deploying.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# NODE_ENV=production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=habitable_planets
DB_USER=postgres
DB_PASSWORD=your_postgres_password

JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
# Required for registering new researcher accounts; keep private
RESEARCHER_SIGNUP_KEY=replace_with_a_different_long_random_key
# Optional: restrict API cross-origin requests to your deployed frontend
# FRONTEND_ORIGIN=http://localhost:5000
